# ================================================================
# CFC (Culling Foto Creative) — Environment Variables
# Salin file ini menjadi .env dan sesuaikan nilainya
# JANGAN commit file .env ke repository!
# ================================================================

# ── Node Environment ──────────────────────────────────────────
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=cfc-foto
POSTGRES_USER=ycuser
POSTGRES_PASSWORD=123456

# ── MinIO Object Storage ──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=irsandoni123

# ── Backend API ───────────────────────────────────────────────
# Kunci rahasia untuk signing JWT (minimal 32 karakter acak)
JWT_SECRET=ganti_dengan_string_rahasia_minimal_32_karakter
JWT_EXPIRES_IN=7d

# Origin yang diizinkan CORS (gunakan URL frontend yang sebenarnya di production)
CORS_ORIGIN=http://localhost:3000

# ── Image Proxy ───────────────────────────────────────────────
# Teks watermark yang tampil di atas foto pratinjau klien
WATERMARK_TEXT=© CFC

# Kunci rahasia internal proxy (opsional untuk signed URL di masa depan)
PROXY_SECRET=ganti_proxy_secret_di_sini

# ── Photo Quality Service ─────────────────────────────────────
# Threshold bisa di-tune tanpa rebuild Docker image
BLUR_THRESHOLD=100        # Variance Laplacian; lebih rendah = lebih sensitif
EAR_THRESHOLD=0.21        # Eye Aspect Ratio; lebih tinggi = lebih sensitif
HAMMING_THRESHOLD=5       # Hamming distance; lebih rendah = lebih ketat
PHOTO_QUALITY_URL=http://localhost:6000

# ── Frontend (Vite) ───────────────────────────────────────────
# URL backend API (dari perspektif browser)
VITE_API_URL=http://localhost:4000/api

# URL image proxy (dari perspektif browser)
VITE_PROXY_URL=http://localhost:5000
