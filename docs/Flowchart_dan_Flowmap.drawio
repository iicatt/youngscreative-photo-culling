        </mxCell>

        <!-- DECISION: Proxy OK? -->
        <mxCell id="F22" value="Proxy OK &amp;&#xa;data &gt; 1000 bytes ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="1790" width="210" height="70" as="geometry"/>
        </mxCell>

        <!-- PROCESS: Fallback MinIO -->
