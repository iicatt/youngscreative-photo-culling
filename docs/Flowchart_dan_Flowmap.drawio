        <!-- DECISION: Sesi valid? -->
        <mxCell id="F11" value="Sesi milik&#xa;fotografer ini ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="870" width="210" height="70" as="geometry"/>
        </mxCell>

        <!-- OUTPUT: 404 -->
        <mxCell id="F12" value="OUTPUT: 404&#xa;'Sesi tidak ditemukan'" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="875" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- PROCESS: createReadStream & putObject -->
        <mxCell id="F13" value="PROCESS: fs.createReadStream(file.path)&#xa;→ minioClient.putObject(bucket, key, stream)&#xa;fotoController.uploadFoto()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="980" width="270" height="60" as="geometry"/>
        </mxCell>

        <!-- DECISION: putObject sukses? -->
        <mxCell id="F14" value="putObject&#xa;berhasil ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="1080" width="210" height="70" as="geometry"/>
        </mxCell>

        <!-- PROCESS: Hapus temp + push failed -->
        <mxCell id="F15" value="PROCESS: fs.unlinkSync(tmpfile)&#xa;push ke failed[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="1085" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- PROCESS: unlink + INSERT DB -->
        <mxCell id="F16" value="PROCESS: fs.unlink(tmpfile)&#xa;INSERT INTO foto (sesi_id, nama_file,&#xa;object_key, ukuran_file, tipe_file)&#xa;fotoController.uploadFoto()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="1190" width="270" height="70" as="geometry"/>
        </mxCell>

        <!-- OUTPUT: Response JSON -->
        <mxCell id="F17" value="OUTPUT: res.json&#xa;{berhasil, gagal, uploaded[], failed[]}" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="1300" width="270" height="50" as="geometry"/>
        </mxCell>

        <!-- INPUT: Klik RE-ANALYZE ALL -->
        <mxCell id="F18" value="INPUT: Fotografer klik&#xa;RE-ANALYZE ALL&#xa;AiCullingPanel.jsx" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="1390" width="270" height="60" as="geometry"/>
        </mxCell>

        <!-- PROCESS: Reset quality -->
        <mxCell id="F19" value="PROCESS: POST /quality-trigger-all&#xa;UPDATE foto SET quality_analyzed=FALSE&#xa;qualityController.triggerSemua()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="1490" width="270" height="60" as="geometry"/>
        </mxCell>

        <!-- PROCESS: Loop triggerQualityAnalysis -->
        <mxCell id="F20" value="PROCESS: Loop tiap foto →&#xa;triggerQualityAnalysis() fire-and-forget&#xa;qualityWebhook.js: setImmediate()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="1590" width="270" height="60" as="geometry"/>
        </mxCell>

        <!-- PROCESS: Download via proxy -->
        <mxCell id="F21" value="PROCESS: download_image_bytes()&#xa;GET /proxy/bucket/key?preset=analysis&amp;fmt=png&#xa;minio_client.py (via Image Proxy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
