          <mxGeometry x="720" y="1795" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- PROCESS: Resize + Analyze -->
        <mxCell id="F24" value="PROCESS: load_and_resize(bytes, 1200px)&#xa;image_utils.py: ANALYSIS_MAX_WIDTH=1200&#xa;Paralel:&#xa;• blur_analyzer: Laplacian.var() &lt; 100&#xa;• eye_analyzer: EAR &lt; 0.21&#xa;• duplicate_analyzer: pHash hamming &lt; 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="1900" width="270" height="100" as="geometry"/>
        </mxCell>

